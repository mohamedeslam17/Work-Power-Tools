__pycache__/
*.py[cod]
*.pyo
.env
*.docx
*.pdf
*.xlsx

# customer-derived micrographs — keep the folder, not its contents
photo_library/*
!photo_library/.gitkeep

# Streamlit secrets (never commit)
.streamlit/secrets.toml

# Recovered real-report corpus (customer documents) — see scripts/recover_corpus.py
corpus/

# Customer chemistry fingerprints (local composition-store backend) — same
# rationale as photo_library/: keep the folder, never the customer-derived data
composition_store/*
!composition_store/.gitkeep
