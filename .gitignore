__pycache__/
*.py[cod]
*.pyo
.env
*.docx
*.pdf
*.xlsx

# customer-derived micrographs — keep the folder, not its contents
photo_library/*
!photo_library/.gitkeep

# customer chemistry fingerprints (local composition-store backend) — same
# rationale as photo_library/: keep the folder, not customer-derived data
composition_store/*
!composition_store/.gitkeep

# Streamlit secrets (never commit)
.streamlit/secrets.toml
